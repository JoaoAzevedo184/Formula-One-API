PORT=3333

# --- Desenvolvimento local (Docker Compose) ---
# Porta 5434 no host (mapeada para 5432 no container); banco "api-formula-one".
# DATABASE_URL="postgresql://postgres:postgres@localhost:5434/api-formula-one"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5434/api-formula-one"

# --- Produção (Neon) ---
# Pooled — usada pela aplicação (tem "-pooler" no hostname)
DATABASE_URL="postgresql://user:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Direta — usada pelo CLI do Prisma (sem "-pooler")
DIRECT_URL="postgresql://user:senha@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require"
